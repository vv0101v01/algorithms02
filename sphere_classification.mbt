///|\
// Internal integers, quotient presentations of homotopy groups,
// and canonical spherical loop representatives.
//
// The integer type and the `pi_n` quotient types below are genuine
// kernel types.  The loop representatives are also kernel values:
// the generator of `Omega^d(S^d)` is obtained from the circle loop
// by the suspension unit, re-based along an explicit cancellation
// square for `meridian(base) . sym(meridian(base))`.
//
// This file intentionally does not pretend that the displayed
// representative calculus is the full synthetic classification
// theorem.  It supplies the decode direction and a normal-form
// calculus for the cellular representatives generated by the
// spherical generator, inverse and composition.  A general
// encode/decode equivalence for arbitrary elements of
// `pi_3(S^3)` or `pi_3(S^2)` would additionally require the
// suspension flattening / Hopf-fibration arguments; those are not
// generated by merely naming the quotient type.

// ---------------------------------------------------------------------------
// The internal integer type
// ---------------------------------------------------------------------------

///|
/// Integers as a generated inductive type: zero, positive
/// successors, and negative successors.  In `posSucc(n)` and
/// `negSucc(n)`, the schema-natural `n` denotes one less than the
/// absolute value, so every integer has a unique constructor form.
pub fn integer_schema() -> DInductiveSpec {
  let nat_ty = DInductive(nat_schema(), [])
  dinductive_spec("IntegerS", 0, [], [], [
    dconstructor_spec("zero", []),
    dconstructor_spec("posSucc", [darg_external("pred_abs", nat_ty)]),
    dconstructor_spec("negSucc", [darg_external("pred_abs", nat_ty)]),
  ])
}

///|
pub fn integer_type_term() -> DTerm {
  DInductive(integer_schema(), [])
}

///|
pub fn integer_type_value() -> DValue {
  DVInductive(integer_schema(), [], [])
}

///|
fn integer_nat_value(n : Int32) -> DValue {
  let spec = nat_schema()
  let mut out : DValue = DVIntro(spec, 0, [], [])
  for _i in 0..<n {
    out = DVIntro(spec, 1, [], [out])
  }
  out
}

///|
pub fn integer_value(n : Int32) -> DValue {
  let spec = integer_schema()
  if n == 0 {
    DVIntro(spec, 0, [], [])
  } else if n > 0 {
    DVIntro(spec, 1, [], [integer_nat_value(n - 1)])
  } else {
    DVIntro(spec, 2, [], [integer_nat_value(0 - n - 1)])
  }
}

///|
pub fn integer_term(n : Int32) -> DTerm {
  let spec = integer_schema()
  if n == 0 {
    schema_intro_term(spec, 0, [], [])
  } else if n > 0 {
    schema_intro_term(spec, 1, [], [nat_schema_lit(n - 1)])
  } else {
    schema_intro_term(spec, 2, [], [nat_schema_lit(0 - n - 1)])
  }
}

///|
fn integer_succ_nat_value(n : DValue) -> DValue {
  DVIntro(nat_schema(), 1, [], [n])
}

///|
fn integer_pred_abs_or_zero(
  n : DValue,
  if_zero : DValue,
  wrap : (DValue) -> DValue,
) -> DValue {
  match force_value(n) {
    DVIntro(_, 1, _, args) =>
      if args.length() == 1 {
        wrap(args[0])
      } else {
        if_zero
      }
    _ => if_zero
  }
}

///|
/// Successor on canonical integer values.  The function is the
/// constructor computation induced by the three integer cases.
pub fn integer_succ_value(value : DValue) -> DValue {
  let spec = integer_schema()
  match force_value(value) {
    DVIntro(_, 0, _, _) => integer_value(1)
    DVIntro(_, 1, _, args) =>
      DVIntro(spec, 1, [], [integer_succ_nat_value(args[0])])
    DVIntro(_, 2, _, args) =>
      integer_pred_abs_or_zero(args[0], integer_value(0), n => {
        DVIntro(spec, 2, [], [n])
      })
    _ => value
  }
}

///|
/// Predecessor on canonical integer values.
pub fn integer_pred_value(value : DValue) -> DValue {
  let spec = integer_schema()
  match force_value(value) {
    DVIntro(_, 0, _, _) => integer_value(-1)
    DVIntro(_, 1, _, args) =>
      integer_pred_abs_or_zero(args[0], integer_value(0), n => {
        DVIntro(spec, 1, [], [n])
      })
    DVIntro(_, 2, _, args) =>
      DVIntro(spec, 2, [], [integer_succ_nat_value(args[0])])
    _ => value
  }
}

// ---------------------------------------------------------------------------
// Homotopy-group quotient types
// ---------------------------------------------------------------------------

///|
/// The `n`-th homotopy group presented as the quotient of the
/// `n`-fold loop space by the propositionally truncated path
/// relation.  This is the usual representative-level presentation
/// of `pi_n`; its points are loop representatives modulo a path.
pub fn homotopy_group_type_term(a : DTerm, base : DTerm, n : Int32) -> DTerm {
  let loop_ty = loop_space_type_term(a, base, n)
  let relation = DLam(
    loop_ty,
    DLam(loop_ty, trunc_type_term(DPath(loop_ty, DTVar(1), DTVar(0)))),
  )
  DHitType(quotient_schema(), [loop_ty, relation])
}

///|
pub fn sphere_type_term(dim : Int32) -> DTerm {
  DHitType(sphere_schema(dim), [])
}

///|
pub fn sphere_north_term(dim : Int32) -> DTerm {
  hit_intro_term(sphere_schema(dim), 0, [], [], [])
}

///|
/// `pi_3(S^dim)` as an internal quotient type (used with
/// `dim = 2` and `dim = 3` below).
pub fn pi3_sphere_type_term(dim : Int32) -> DTerm {
  homotopy_group_type_term(sphere_type_term(dim), sphere_north_term(dim), 3)
}

///|
/// The quotient point represented by a closed 3-loop term.
pub fn pi3_sphere_point_term(dim : Int32, loop_term : DTerm) -> DTerm {
  let loop_ty = loop_space_type_term(
    sphere_type_term(dim),
    sphere_north_term(dim),
    3,
  )
  let relation = DLam(
    loop_ty,
    DLam(loop_ty, trunc_type_term(DPath(loop_ty, DTVar(1), DTVar(0)))),
  )
  quotient_point_term([loop_ty, relation], loop_term)
}

// ---------------------------------------------------------------------------
// Semantic loop spaces and suspension of loops
// ---------------------------------------------------------------------------

///|
pub fn sphere_type_value(dim : Int32) -> DValue {
  DVHitType(sphere_schema(dim), [], [])
}

///|
pub fn sphere_north_value(dim : Int32) -> DValue {
  if dim <= 1 {
    circle_hit_base_value()
  } else {
    DVHitCell(sphere_schema(dim), 0, [], [], [])
  }
}

///|
pub fn iterated_refl_value(base : DValue, n : Int32) -> DValue {
  if n <= 0 {
    base
  } else {
    DVPathLam(_ => iterated_refl_value(base, n - 1))
  }
}

///|
pub fn loop_space_type_value(ty : DValue, base : DValue, n : Int32) -> DValue {
  if n <= 0 {
    ty
  } else {
    let previous_ty = loop_space_type_value(ty, base, n - 1)
    let point = iterated_refl_value(base, n - 1)
    DVPathTy(_ => previous_ty, point, point)
  }
}

///|
/// Cancellation of a path followed by its inverse.  The resulting
/// value is a path in `Path(ty, x, x)` from `p . sym(p)` to
/// `refl(x)`, obtained by turning the corner of the transitivity
/// square with a four-face `hcomp`.
pub fn dpath_trans_sym_cancel_value(
  ty : DValue,
  p : DValue,
  start : DValue,
  dlevel : Int32,
) -> DValue {
  let square = dpath_trans_square_value(ty, p, dpath_sym_value(p), dlevel)
  let at = (a : Dim, b : Dim) => dapp_dim(dapp_dim(square, a), b)
  DVPathLam(r => {
    DVPathLam(i => {
      let not_r = dim_simplify(DNeg(r))
      let a = dim_simplify(DAnd(i, not_r))
      let b = dim_simplify(DOr(not_r, DAnd(i, r)))
      let branches = dsystem_of([
        tube_branch(face_simplify(FEq0(i)), _ => start),
        tube_branch(face_simplify(FEq1(i)), m => {
          at(dim_simplify(DOr(not_r, m)), DOne)
        }),
        tube_branch(face_simplify(FEq0(r)), _ => at(i, DOne)),
        tube_branch(face_simplify(FEq1(r)), _ => start),
      ])
      hcomp_value(ty, branches, at(a, b), dlevel + 4)
    })
  })
}

///|
fn map_iterated_loop_value(
  f : DValue,
  source_ty : DValue,
  point : DValue,
  order : Int32,
) -> DValue {
  if order <= 0 {
    dapp_typed(f, point, source_ty)
  } else {
    DVPathLam(d => {
      map_iterated_loop_value(f, source_ty, dapp_dim(point, d), order - 1)
    })
  }
}

///|
/// Suspend an iterated loop.  If `point : Omega^order(X, base)`
/// and `target_spec` is the suspension of `X`, the result lies in
/// `Omega^(order+1)(Susp(X), north)`.  Pointwise application of
/// the suspension unit lands in the loop space based at
/// `unit(base)`; transport along the cancellation path above
/// re-bases it at `refl(north)`.
pub fn suspend_loop_value(
  target_spec : DHitSpec,
  source_ty : DValue,
  base_point : DValue,
  point : DValue,
  order : Int32,
  dlevel : Int32,
) -> DValue {
  let target_ty : DValue = DVHitType(target_spec, [], [])
  let north = DVHitCell(target_spec, 0, [], [], [])
  let unit = DVLam(x => {
    suspension_unit_loop_value(target_spec, base_point, x, dlevel)
  })
  let raw = map_iterated_loop_value(unit, source_ty, point, order)
  let meridian_base = suspension_meridian_path_value(target_spec, base_point)
  let cancel = dpath_trans_sym_cancel_value(
    target_ty, meridian_base, north, dlevel,
  )
  let first_loop_ty = loop_space_type_value(target_ty, north, 1)
  subst_value(
    q => loop_space_type_value(first_loop_ty, q, order),
    cancel,
    raw,
    dlevel,
  )
}

///|
/// The degree-`n` element of `Omega^dim(S^dim)`, constructed from
/// the `n`-th power of the circle loop by iterated suspension.
pub fn sphere_loop_power_value(dim : Int32, n : Int32) -> DValue {
  if dim <= 1 {
    circle_hit_loop_power_value(n)
  } else {
    suspend_loop_value(
      sphere_schema(dim),
      sphere_type_value(dim - 1),
      sphere_north_value(dim - 1),
      sphere_loop_power_value(dim - 1, n),
      dim - 1,
      6,
    )
  }
}

// ---------------------------------------------------------------------------
// Cellular representative calculus
// ---------------------------------------------------------------------------

///|
/// The free representative calculus generated by reflexivity, the
/// spherical generator, inverse and loop composition.  Its degree
/// is defined by the usual group homomorphism to the integers.
pub enum SphereLoopExpr {
  SphereLoopRefl
  SphereLoopGenerator
  SphereLoopInverse(SphereLoopExpr)
  SphereLoopCompose(SphereLoopExpr, SphereLoopExpr)
} derive(Debug, Eq)

///|
pub extend SphereLoopExpr with @moonbitlang/core/debug.Debug::{to_repr}

///|
pub extend SphereLoopExpr with Eq::{not_equal, equal}

///|
pub fn sphere_loop_expr_degree(expr : SphereLoopExpr) -> Int32 {
  match expr {
    SphereLoopRefl => 0
    SphereLoopGenerator => 1
    SphereLoopInverse(a) => 0 - sphere_loop_expr_degree(a)
    SphereLoopCompose(a, b) =>
      sphere_loop_expr_degree(a) + sphere_loop_expr_degree(b)
  }
}

///|
pub fn sphere_loop_expr_of_integer(n : Int32) -> SphereLoopExpr {
  if n == 0 {
    SphereLoopRefl
  } else if n > 0 {
    let mut out = SphereLoopGenerator
    for _i in 1..<n {
      out = SphereLoopCompose(out, SphereLoopGenerator)
    }
    out
  } else {
    SphereLoopInverse(sphere_loop_expr_of_integer(0 - n))
  }
}

///|
/// Multiplication in the top loop coordinate of
/// `Omega^dim(S^dim)`.
pub fn sphere_loop_compose_value(
  dim : Int32,
  a : DValue,
  b : DValue,
  dlevel : Int32,
) -> DValue {
  let previous_ty = loop_space_type_value(
    sphere_type_value(dim),
    sphere_north_value(dim),
    dim - 1,
  )
  dpath_trans_value(previous_ty, a, b, dlevel)
}

///|
/// Evaluate a representative expression in `Omega^dim(S^dim)`.
/// For `dim = 3` this is the decode map on cellular
/// representatives of `pi_3(S^3)`.
pub fn sphere_loop_expr_value(dim : Int32, expr : SphereLoopExpr) -> DValue {
  match expr {
    SphereLoopRefl => iterated_refl_value(sphere_north_value(dim), dim)
    SphereLoopGenerator => sphere_loop_power_value(dim, 1)
    SphereLoopInverse(a) => dpath_sym_value(sphere_loop_expr_value(dim, a))
    SphereLoopCompose(a, b) =>
      sphere_loop_compose_value(
        dim,
        sphere_loop_expr_value(dim, a),
        sphere_loop_expr_value(dim, b),
        6,
      )
  }
}

///|
fn sphere_loop_endpoint_ok(dim : Int32, loop_value : DValue) -> Bool {
  let previous_ty = loop_space_type_value(
    sphere_type_value(dim),
    sphere_north_value(dim),
    dim - 1,
  )
  let endpoint = iterated_refl_value(sphere_north_value(dim), dim - 1)
  conv_at(0, 0, previous_ty, dapp_dim(loop_value, DZero), endpoint) &&
  conv_at(0, 0, previous_ty, dapp_dim(loop_value, DOne), endpoint)
}

///|
/// Checks for the internal integer/`pi_3` types and for the
/// canonical representatives.  The degree assertions classify the
/// representative calculus; the endpoint assertions check that
/// its values inhabit the advertised iterated loop spaces.
pub fn check_sphere_loop_representatives_internal() -> Bool {
  if !inductive_schema_validate(integer_schema()) {
    return false
  }
  for n in [-3, -1, 0, 1, 4] {
    if !dep_check_closed(integer_term(n), integer_type_term()) {
      return false
    }
    if !conv_at(
        0,
        0,
        integer_type_value(),
        integer_pred_value(integer_succ_value(integer_value(n))),
        integer_value(n),
      ) ||
      !conv_at(
        0,
        0,
        integer_type_value(),
        integer_succ_value(integer_pred_value(integer_value(n))),
        integer_value(n),
      ) {
      return false
    }
  }
  if !dep_check_closed(pi3_sphere_type_term(2), DUniv(0)) ||
    !dep_check_closed(pi3_sphere_type_term(3), DUniv(0)) {
    return false
  }
  // Representative degree is a two-way normal form on expressions.
  for n in [-5, -2, 0, 1, 3, 7] {
    if sphere_loop_expr_degree(sphere_loop_expr_of_integer(n)) != n {
      return false
    }
  }
  let composite = SphereLoopCompose(
    SphereLoopInverse(SphereLoopGenerator),
    SphereLoopCompose(SphereLoopGenerator, SphereLoopGenerator),
  )
  if sphere_loop_expr_degree(composite) != 1 {
    return false
  }
  // Canonical loops have the correct outer endpoints in the
  // iterated loop spaces of S^2 and S^3.
  for dim in [2, 3] {
    for n in [-1, 0, 1, 2] {
      if !sphere_loop_endpoint_ok(dim, sphere_loop_power_value(dim, n)) {
        return false
      }
    }
    if !sphere_loop_endpoint_ok(dim, sphere_loop_expr_value(dim, composite)) {
      return false
    }
  }
  true
}
