  proj : (Double) -> CMat
}

pub struct SymRegion {
  value : Array[Complex]
  mut region : Bdd
}

pub struct SystemNF {
  classes : Array[SymRegion]
  undefined : Bdd
}

pub enum TNeutral {
  TNeVar(Int32)
  TNeApp(TNeutral, TValue, LTy)
  TNeFst(TNeutral, LTy)
  TNeSnd(TNeutral, LTy)
}

pub enum TValue {
  TVUnit
  TVBool(Bool)
  TVPair(TValue, TValue)
  TVClosure((TValue) -> TValue)
  TVNeutral(TNeutral)
}

pub enum Term {
  TmVar(Int32)
  TmLam(Term)
  TmApp(Term, Term)
  TmPair(Term, Term)
  TmFst(Term)
  TmSnd(Term)
  TmBool(Bool)
  TmUnit
  TmCoeRefl
  TmCoeUaSwap
  TmAnn(Term, LTy)
} derive(Eq, @debug.Debug)
pub fn Term::equal(Self, Self) -> Bool
pub fn Term::not_equal(Self, Self) -> Bool
pub fn Term::to_repr(Self) -> @debug.Repr

pub enum Ty {
  TyBool
  TyUnit
  TyProd(Ty, Ty)
} derive(Eq, @debug.Debug)
pub fn Ty::equal(Self, Self) -> Bool
pub fn Ty::not_equal(Self, Self) -> Bool
pub fn Ty::to_repr(Self) -> @debug.Repr

pub struct TypedValue {
  value : TValue
  ty : LTy
}

pub struct UMetaInfo {
  context_depth : Int32
  mut solution : UTerm?
} derive(Eq, @debug.Debug)
pub fn UMetaInfo::equal(Self, Self) -> Bool
pub fn UMetaInfo::not_equal(Self, Self) -> Bool
pub fn UMetaInfo::to_repr(Self) -> @debug.Repr

pub struct UPath {
  equiv : Equiv
}

pub enum UTerm {
  UVar(Int32)
  UMeta(Int32, Array[UTerm])
  UConst(String)
  UType(Int32)
  ULam(UTerm, UTerm)
  UApp(UTerm, UTerm)
  UPi(UTerm, UTerm)
  UImplicitPi(UTerm, UTerm)
  USigma(UTerm, UTerm)
  UPair(UTerm, UTerm)
  UFst(UTerm)
  USnd(UTerm)
  UBoolLit(Bool)
  UNatZero
  USucc(UTerm)
  UNatElim(UTerm, UTerm, UTerm, UTerm)
} derive(Eq, @debug.Debug)
pub fn UTerm::equal(Self, Self) -> Bool
pub fn UTerm::not_equal(Self, Self) -> Bool
pub fn UTerm::to_repr(Self) -> @debug.Repr

pub struct Unifier {
  metas : Array[UMetaInfo]
  mut solved_count : Int32
} derive(Eq, @debug.Debug)
pub fn Unifier::equal(Self, Self) -> Bool
pub fn Unifier::not_equal(Self, Self) -> Bool
pub fn Unifier::to_repr(Self) -> @debug.Repr

pub struct UniversePath {
  line : DCheckedTypeLine
  src : DValue
  dst : DValue
  level : Int32
}

pub enum Value {
  VUnit
  VBool(Bool)
  VPair(Value, Value)
  VClosure((Value) -> Value)
  VNeutral(Neutral)
}

pub struct VecBox {
  bottom : Cube
  left : Cube
  right : Cube
}

pub struct VecBranch {
  face : Face
  value : Array[Complex]
}

pub struct VecSystem {
  branches : Array[VecBranch]
}

pub struct Wiring {
  src : Ty
  dst : Ty
  mapping : Array[LeafMap]
}

// Type aliases
pub type AlgCertVec = Array[AlgC]

pub type CVec = Array[Complex]

pub type CertVec = Array[QuadC]

